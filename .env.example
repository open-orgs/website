# Production secrets. Copy to .env, fill in, then:
#   npx wrangler deploy --secrets-file .env
#
# .env is gitignored. Non-secret values (SENDER_EMAIL, TURNSTILE_SITE_KEY) live in wrangler.jsonc
# under `vars`, not here.

# Where new signatory and consultation notifications are sent.
ADMIN_EMAIL=""

# Turnstile secret key, from the widget's settings in the Cloudflare dashboard.
# The matching site key is public and belongs in wrangler.jsonc.
TURNSTILE_SECRET_KEY=""
