# Local secrets for `wrangler dev`. Copy to .dev.vars and fill in — .dev.vars is gitignored.
#
# Turnstile publishes always-pass / always-fail test keys for local work:
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Site key 1x00000000000000000000AA + secret 1x0000000000000000000000000000000AA always pass.

ADMIN_EMAIL=""
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
